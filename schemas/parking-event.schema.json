{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/parkping/parking-event.schema.json",
  "title": "ParkPing Parking Occupancy Event",
  "description": "Portfolio reference contract derived from the documented MQTT telemetry design. It is not claimed as a historical deployed schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "parking_area",
    "slot_id",
    "occupied",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "parking_area": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "slot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "occupied": {
      "type": "boolean"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
